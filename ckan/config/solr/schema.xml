    <!-- MaPP controlled vocabularies (ckanext-mapp). Inert on the other sites,
         but they cannot be left to the catch-all `*` dynamicField: that is
         single-valued, so a dataset in two sub-regions would fail to index.
         All four are multiValued, matching the schema the MaPP deployment
         already runs (parent branch MaPP_master). theme and sub-theme are
         single `select` fields and only ever carry one value, but declaring
         them single-valued would turn any legacy multi-valued record into an
         indexing failure. -->
    <field name="mapp-theme" type="string" indexed="true" stored="true" multiValued="true" />
    <field name="mapp-sub-theme" type="string" indexed="true" stored="true" multiValued="true" />
    <field name="mapp-sub-region" type="string" indexed="true" stored="true" multiValued="true" />
    <field name="mapp-project" type="string" indexed="true" stored="true" multiValued="true" />
    <field name="resorg_groups" type="string" indexed="true" stored="true" multiValued="true" />
    <field name="resorg_groups_en" type="string" indexed="true" stored="true" multiValued="true" />
    <field name="resorg_groups_fr" type="string" indexed="true" stored="true" multiValued="true" />
    <field name="organization_en" type="string" indexed="true" stored="true" multiValued="false" />
    <field name="organization_fr" type="string" indexed="true" stored="true" multiValued="false" />
    <field name="harvest_source_title" type="string" indexed="true" stored="true" multiValued="false" />
    <field name="text_en" type="text" indexed="true" stored="false" multiValued="true" />
    <field name="text_fr" type="text_fr" indexed="true" stored="false" multiValued="true" />
    <dynamicField name="*_en" type="text" indexed="true" stored="false" multiValued="false" />
    <dynamicField name="*_fr" type="text_fr" indexed="true" stored="false" multiValued="false" />
